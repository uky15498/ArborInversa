#!/bin/sh
# 提交前自检（启用方式：git config core.hooksPath tools/git-hooks）
#   1) 编解码自测  2) 搜索/属性自测  3) 应用版数据是否已快照进库
set -e
cd "$(git rev-parse --show-toplevel)"

echo "· 编解码自测…"
node tools/codec.test.js > /dev/null || { echo "× 编解码自测未通过，提交中止"; exit 1; }

echo "· 搜索/属性自测…"
node tools/search.test.js > /dev/null || { echo "× 搜索自测未通过，提交中止"; exit 1; }

echo "· 检查内容快照（示例页 / media / 仓库空框架树）…"
node tools/snapshot.js --check || {
  echo "× 内容快照不一致 —— 先跑：node tools/snapshot.js"
  exit 1
}

echo "✓ 自检通过"
